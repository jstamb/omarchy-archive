---
import markSvg from '../../public/brand/omarchy-mark.svg?raw';
import Sidebar from '../components/Sidebar.astro';
import '../styles/global.css';
import { counts, formatDate, meta } from '../lib/content';

interface Props {
  title?: string;
  description?: string;
  /** Path of this page, trailing slash, for canonical + nav highlighting. */
  path: string;
  /** Set false on pages that should not be in the Pagefind index. */
  indexable?: boolean;
  /** og:image override; defaults to the site card. */
  image?: string;
}

const { title, description, path, indexable = true, image = '/og.png' } = Astro.props;

// Inlined rather than <img src>: it is 2KB, it saves a request on every page,
// and inline SVG inherits `currentColor` so the mark tracks the link colour on
// hover. Generated from the official PNG by scripts/make-mark.mjs.
const markPaths = markSvg
  .replace(/^[\s\S]*?<svg[^>]*>/, '')
  .replace(/<\/svg>\s*$/, '')
  .trim();

const pageTitle = title ? `${title} — ${meta.site_name}` : `${meta.site_name} — ${meta.tagline}`;
const pageDescription = description ?? meta.tagline;
const canonical = new URL(path, meta.site_url).href;
const ogImage = new URL(image, meta.site_url).href;

const nav = [
  { href: '/posts/', label: 'Feed' },
  { href: '/setups/', label: 'Setups' },
  { href: '/resources/', label: 'Resources' },
  { href: '/themes/', label: 'Themes' },
  { href: '/plugins/', label: 'Plugins' },
  { href: '/sources/', label: 'Sources' },
  { href: '/history/', label: 'History' },
  { href: '/install/', label: 'Install' },
  { href: '/about/', label: 'About' },
];

const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {/* Both faces paint above the fold — the UI face everywhere, the wordmark
        in the logo — so fetch them with the HTML instead of waiting for the
        stylesheet to resolve. 31KB + 7.7KB. */}
    <link
      rel="preload"
      href="/fonts/jetbrains-mono-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/omarchy-font.ttf"
      as="font"
      type="font/ttf"
      crossorigin="anonymous"
    />
    <meta name="theme-color" content="#1a1b26" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={meta.site_name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    {/*
      Rybbit. Injected rather than written as a plain tag because the hosted
      script has no localhost guard of its own — I checked, there is not a
      single reference to localhost or 127.0.0.1 in it — so a `dist` served
      locally for a screenshot posts real pageviews into the production site's
      numbers. Skipping local hostnames keeps development out of the data.

      Custom events are fired from src/scripts/analytics.ts.
    */}
    <script is:inline data-rybbit-loader>
      if (!/^(localhost|127\.0\.0\.1|\[::1\])$/.test(location.hostname) && !location.hostname.endsWith('.local')) {
        const tag = document.createElement('script');
        tag.src = 'https://app.rybbit.io/api/script.js?siteId=3c1d3040bd5f';
        tag.defer = true;
        document.head.append(tag);
      }
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="masthead">
      <div class="shell masthead__inner">
        <a class="brand" href="/" aria-label={`${meta.site_name} — home`}>
          <svg
            class="brand__mark"
            viewBox="0 0 15 15"
            fill="currentColor"
            aria-hidden="true"
            set:html={markPaths}
          />
          <span class="brand__name">{meta.site_name}</span>
        </a>
        <nav class="nav" aria-label="Sections">
          {
            nav.map((item) => (
              <a
                class="nav__link"
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        <a class="nav__link" href={meta.repo_url} rel="noopener">GitHub</a>
      </div>
    </header>

    <div class="shell layout">
      <Sidebar path={path} />
      <main id="main" class="layout__main">
        <div data-pagefind-body={indexable ? '' : undefined}>
          <slot />
        </div>
      </main>
    </div>

    <footer class="footer">
      <div class="shell footer__row">
        <span>{meta.positioning}</span>
        <span>
          {counts.posts} posts · {counts.themes} themes · {counts.plugins} plugins ·{' '}
          {counts.releases} releases · {counts.sources} sources
        </span>
        <span>Last updated {formatDate(meta.updated_at)}</span>
        <a href={meta.repo_url} rel="noopener">Source on GitHub</a>
        <a href="/about/">About</a>
      </div>

      <div class="shell">
        <a class="madeby" href="https://www.stambaughdesigns.co" rel="noopener">
          <span class="madeby__text">a</span>
          <img
            class="madeby__logo"
            src="/brand/stambaugh-designs.webp"
            alt="Stambaugh Designs"
            width="420"
            height="131"
            loading="lazy"
            decoding="async"
          />
          <span class="madeby__text">Project</span>
        </a>
      </div>
    </footer>

    <script>
      import { track } from '../scripts/analytics';

      // One delegated listener for every copy button on the page.
      document.addEventListener('click', async (event) => {
        const button = (event.target as HTMLElement | null)?.closest<HTMLButtonElement>(
          '[data-copy]',
        );
        if (!button) return;
        /*
         * Copying an install command is the thing this site is for. Every card
         * and every detail page ends in one of these buttons, so this is the
         * closest thing the archive has to a conversion.
         */
        track('copy_command', {
          // The command's first two words - `omarchy theme set`, `omarchy
          // plugin add` - not the whole string, which would make one row per
          // record instead of one per kind of install.
          command: (button.dataset.copy ?? '').split(/\s+/).slice(0, 3).join(' '),
        });
        const value = button.dataset.copy ?? '';
        try {
          await navigator.clipboard.writeText(value);
        } catch {
          // Clipboard API needs a secure context; fall back to a selection copy.
          const scratch = document.createElement('textarea');
          scratch.value = value;
          scratch.setAttribute('readonly', '');
          scratch.style.position = 'fixed';
          scratch.style.opacity = '0';
          document.body.append(scratch);
          scratch.select();
          document.execCommand('copy');
          scratch.remove();
        }
        const label = button.querySelector('[data-copy-label]') ?? button;
        const original = button.dataset.copyOriginal ?? label.textContent ?? 'Copy';
        button.dataset.copyOriginal = original;
        label.textContent = 'Copied';
        button.dataset.copied = 'true';
        window.setTimeout(() => {
          label.textContent = original;
          delete button.dataset.copied;
        }, 1400);
      });

      /*
       * Outbound clicks. The whole premise is pointing at other people's work,
       * so which records send people onward is the measure of whether the
       * index earns its keep. Host only - the destination URL is already on
       * the record in git.
       */
      document.addEventListener('click', (event) => {
        const link = (event.target as HTMLElement | null)?.closest('a');
        if (!link?.href.startsWith('http')) return;
        const url = new URL(link.href);
        if (url.host === location.host) return;
        track('outbound', { host: url.host });
      });
    </script>
  </body>
</html>
