---
import markSvg from '../../public/brand/omarchy-mark.svg?raw';
import Sidebar from '../components/Sidebar.astro';
import ThemeSwitcher from '../components/ThemeSwitcher.astro';
import '../styles/global.css';
import { counts, formatDate, formatIndexStamp, meta } from '../lib/content';

interface Props {
  title?: string;
  description?: string;
  /** Path of this page, trailing slash, for canonical + nav highlighting. */
  path: string;
  /** Set false on pages that should not be in the Pagefind index. */
  indexable?: boolean;
  /** og:image override; defaults to the site card. */
  image?: string;
  /** Pagefind entity facet for the indexed body root, e.g. "setup" or "theme". */
  searchType?: string;
}

const { title, description, path, indexable = true, image = '/og.png', searchType } = Astro.props;

// Inlined rather than <img src>: it is 2KB, it saves a request on every page,
// and inline SVG inherits `currentColor` so the mark tracks the link colour on
// hover. Generated from the official PNG by scripts/make-mark.mjs.
const markPaths = markSvg
  .replace(/^[\s\S]*?<svg[^>]*>/, '')
  .replace(/<\/svg>\s*$/, '')
  .trim();

const pageTitle = title ? `${title} — ${meta.site_name}` : `${meta.site_name} — ${meta.tagline}`;
const pageDescription = description ?? meta.tagline;
const canonical = new URL(path, meta.site_url).href;
const ogImage = new URL(image, meta.site_url).href;

// Analytics loads only on the canonical production host, derived from the
// canonical config rather than hardcoded. The hosted Rybbit script has no host
// guard of its own, so this allowlist is what keeps preview deploys and local
// builds out of production's numbers. www is covered only if the canonical URL
// uses it (it does not today — the canonical is the apex).
const analyticsHost = new URL(meta.site_url).hostname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {/* Both faces paint above the fold — the UI face everywhere, the wordmark
        in the logo — so fetch them with the HTML instead of waiting for the
        stylesheet to resolve. 31KB + 7.7KB. */}
    <link
      rel="preload"
      href="/fonts/jetbrains-mono-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/omarchy-font.ttf"
      as="font"
      type="font/ttf"
      crossorigin="anonymous"
    />
    <meta name="theme-color" content="#1a1b26" />
    <meta name="generator" content={Astro.generator} />

    {/*
      Site theme, painted before first render. The picker (scripts/site-theme.ts)
      stores the chosen theme as computed CSS custom properties, so this needs
      no catalog: read, set, done — no flash of Tokyo Night on a Gruvbox
      browser. Keep the shape in step with StoredTheme in that script.
    */}
    <script is:inline>
      try {
        var stored = JSON.parse(localStorage.getItem('omarchy-archive-theme') || 'null');
        if (stored && stored.tokens) {
          var root = document.documentElement;
          for (var name in stored.tokens) root.style.setProperty(name, stored.tokens[name]);
          root.dataset.siteTheme = stored.id;
          root.dataset.tone = stored.tone;
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta && stored.tokens['--bg']) meta.content = stored.tokens['--bg'];
        }
      } catch (e) {}
    </script>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={meta.site_name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    {/*
      Rybbit. Injected rather than written as a plain tag because the hosted
      script has no host guard of its own — there is not a single localhost or
      127.0.0.1 reference in it — so any host that serves the built site (a
      Cloudflare *.pages.dev preview, a branch deploy, a local `dist` served
      for a screenshot) would otherwise post real pageviews into the production
      site's numbers. Loading only on the canonical host is the guard the
      script is missing; the host comes from meta.site_url so it lives in
      exactly one place.

      Custom events are fired from src/scripts/analytics.ts.
    */}
    <script is:inline define:vars={{ analyticsHost }} data-rybbit-loader>
      if (location.hostname === analyticsHost) {
        const tag = document.createElement('script');
        tag.src = 'https://app.rybbit.io/api/script.js?siteId=3c1d3040bd5f';
        tag.defer = true;
        document.head.append(tag);
      }
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <canvas class="pixelfield" data-pixelfield aria-hidden="true"></canvas>

    <header class="masthead">
      <div class="shell masthead__inner">
        {/*
          The narrow-screen navigation. Below 1100px the sidebar is the drawer
          this opens, so there is still exactly one nav in the document — no
          duplicated links to keep in sync and no second set of tab stops.
        */}
        <button
          class="navtoggle"
          type="button"
          aria-label="Menu"
          aria-expanded="false"
          aria-controls="site-nav"
          data-nav-toggle
        >
          <span class="navtoggle__bars" aria-hidden="true">
            <span></span><span></span><span></span>
          </span>
        </button>
        <div class="brand-cluster">
          <a class="brand" href="/" aria-label={`${meta.site_name} — home`}>
            <svg
              class="brand__mark"
              viewBox="0 0 15 15"
              fill="currentColor"
              aria-hidden="true"
              set:html={markPaths}
            />
            <span class="brand__name">{meta.site_name}</span>
          </a>
          <p class="index-live">
            <span class="index-live__dot" aria-hidden="true"></span>
            <time datetime={meta.updated_at}>last indexed: {formatIndexStamp(meta.updated_at)}</time>
          </p>
        </div>
        <a class="masthead__search" href="/search/">Search</a>
        <a class="masthead__link" href={meta.repo_url} rel="noopener">GitHub</a>
        <ThemeSwitcher />
      </div>
    </header>

    <div class="navscrim" data-nav-scrim></div>

    <div class="shell layout">
      <Sidebar path={path} />
      <main id="main" class="layout__main">
        <div
          data-pagefind-body={indexable ? '' : undefined}
          data-pagefind-filter={indexable && searchType ? `type:${searchType}` : undefined}
        >
          <slot />
        </div>
      </main>
    </div>

    <footer class="footer">
      <div class="shell footer__row">
        <span>{meta.positioning}</span>
        <span>
          {counts.posts} posts · {counts.themes} themes · {counts.plugins} plugins ·{' '}
          {counts.releases} releases · {counts.sources} sources
        </span>
        <span>Last updated {formatDate(meta.updated_at)}</span>
        <a href={meta.repo_url} rel="noopener">Source on GitHub</a>
        <a href="/about/">About</a>
      </div>

      <div class="shell">
        <a class="madeby" href="https://www.stambaughdesigns.co" rel="noopener">
          <span class="madeby__text">a</span>
          <img
            class="madeby__logo"
            src="/brand/stambaugh-designs.webp"
            alt="Stambaugh Designs"
            width="420"
            height="131"
            loading="lazy"
            decoding="async"
          />
          <span class="madeby__text">Project</span>
        </a>
      </div>
    </footer>

    <script>
      import { track } from '../scripts/analytics';
      import '../scripts/nav-drawer';
      import '../scripts/pixelfield';
      import '../scripts/saved';
      import '../scripts/site-theme';

      const RESET_MS = 1400;
      const resetTimers = new WeakMap<HTMLButtonElement, number>();

      const statusFor = (button: Element): HTMLElement | null =>
        button.closest('.command, .card')?.querySelector<HTMLElement>('[data-copy-status]') ?? null;

      function snapshotSelection(): Range[] | null {
        const selection = window.getSelection();
        if (!selection || selection.rangeCount === 0) return null;
        const ranges: Range[] = [];
        for (let i = 0; i < selection.rangeCount; i += 1) ranges.push(selection.getRangeAt(i).cloneRange());
        return ranges;
      }

      function restoreSelection(ranges: Range[] | null): void {
        if (!ranges) return;
        const selection = window.getSelection();
        if (!selection) return;
        selection.removeAllRanges();
        for (const range of ranges) selection.addRange(range);
      }

      function selectContents(node: Node): void {
        const selection = window.getSelection();
        if (!selection) return;
        const range = document.createRange();
        range.selectNodeContents(node);
        selection.removeAllRanges();
        selection.addRange(range);
      }

      /*
       * Copy without lying about the result. The async Clipboard API is tried
       * first and its promise only settles on a real write. execCommand is a
       * genuine fallback for insecure contexts; it hijacks focus and the
       * selection, so both are put back when — and only when — it succeeds. A
       * throw or a `false` from either path is a real failure, reported as one.
       */
      async function copyText(value: string): Promise<boolean> {
        if (navigator.clipboard?.writeText) {
          try {
            await navigator.clipboard.writeText(value);
            return true;
          } catch {
            // Denied or insecure context — try the legacy path before failing.
          }
        }
        const active = document.activeElement as HTMLElement | null;
        const saved = snapshotSelection();
        const scratch = document.createElement('textarea');
        scratch.value = value;
        scratch.setAttribute('readonly', '');
        scratch.style.position = 'fixed';
        scratch.style.top = '0';
        scratch.style.opacity = '0';
        document.body.append(scratch);
        scratch.select();
        let ok = false;
        try {
          ok = document.execCommand('copy');
        } catch {
          ok = false;
        }
        scratch.remove();
        // Put focus back where the user left it. On failure the caller
        // re-selects the visible command on purpose, so only the caret is
        // restored here, and only when the copy actually worked.
        active?.focus?.();
        if (ok) restoreSelection(saved);
        return ok;
      }

      function resetButton(button: HTMLButtonElement): void {
        const timer = resetTimers.get(button);
        if (timer) {
          window.clearTimeout(timer);
          resetTimers.delete(button);
        }
        delete button.dataset.copied;
        const status = statusFor(button);
        if (status) {
          status.textContent = '';
          delete status.dataset.copyFailed;
        }
      }

      // One delegated listener for every copy button on the page.
      document.addEventListener('click', async (event) => {
        const button = (event.target as HTMLElement | null)?.closest<HTMLButtonElement>('[data-copy]');
        if (!button) return;

        // A fresh attempt clears any earlier result first, so a denied second
        // click can never inherit "Copied" from an earlier success.
        resetButton(button);

        const value = button.dataset.copy ?? '';
        const status = statusFor(button);
        const copied = await copyText(value);

        if (copied) {
          /*
           * Copying an install command is the thing this site is for, so a
           * verified copy is the closest thing the archive has to a conversion
           * — counted only now the write resolved, never on the click alone.
           */
          track('copy_command', {
            // First three words — `omarchy theme set`, `omarchy plugin add` —
            // not the whole string, which would make one row per record
            // instead of one per kind of install.
            command: value.split(/\s+/).slice(0, 3).join(' '),
          });
          button.dataset.copied = 'true';
          if (status) status.textContent = 'Copied';
          resetTimers.set(
            button,
            window.setTimeout(() => resetButton(button), RESET_MS),
          );
          return;
        }

        // Honest failure: no event, no "Copied". Surface the command so it can
        // still be copied by hand — the visible one if the page shows it,
        // otherwise rendered selectably in the status line.
        const box = button.closest('.command, .card');
        const shown = box?.querySelector<HTMLElement>('pre code, [data-copy-command]');
        if (shown) {
          selectContents(shown);
          if (status) {
            status.dataset.copyFailed = 'true';
            status.textContent = 'Couldn’t copy — the command is selected; press ⌘/Ctrl+C.';
          }
        } else if (status) {
          status.dataset.copyFailed = 'true';
          status.textContent = 'Couldn’t copy — select and copy: ';
          const code = document.createElement('code');
          code.textContent = value;
          status.append(code);
          selectContents(code);
        }
      });

      /*
       * Outbound clicks. The whole premise is pointing at other people's work,
       * so which records send people onward is the measure of whether the
       * index earns its keep. Host only - the destination URL is already on
       * the record in git.
       */
      document.addEventListener('click', (event) => {
        const link = (event.target as HTMLElement | null)?.closest('a');
        if (!link?.href.startsWith('http')) return;
        const url = new URL(link.href);
        if (url.host === location.host) return;
        track('outbound', { host: url.host });
      });
    </script>
    <style>
      /*
       * The mobile search entry. Below 1100px the sidebar — and the search box
       * inside it — is gone, so this is the archive's only global search
       * affordance. It is a sibling of the scrolling section nav, not a child,
       * so it stays put while the nav scrolls sideways; at 1100px and up the
       * sidebar search takes over and this is hidden to avoid a duplicate tab
       * stop for the same destination.
       */
      .masthead__search {
        display: inline-flex;
        align-items: center;
        flex: 0 0 auto;
        white-space: nowrap;
        padding: 0.35rem 0.7rem;
        border: 1px solid var(--line-soft);
        border-radius: var(--radius);
        color: var(--ink-dim);
        font-size: 0.95rem;
        text-decoration: none;
      }
      .masthead__search:hover {
        background: var(--bg-raised);
        color: var(--ink);
        border-color: var(--accent);
      }
      @media (min-width: 1100px) {
        .masthead__search {
          display: none;
        }
      }
    </style>
  </body>
</html>
