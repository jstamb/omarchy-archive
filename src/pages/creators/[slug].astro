---
import Card from '../../components/Card.astro';
import Base from '../../layouts/Base.astro';
import { cacheHeaders, creatorRecords, env } from '../../lib/db';
import { creatorNameBySlug } from '../../lib/summary';

// On demand from D1, cached at the edge; purged by tag after each sync.
export const prerender = false;

const slug = Astro.params.slug ?? '';
const name = creatorNameBySlug(slug);
if (!name) return new Response('Not found', { status: 404, headers: { 'content-type': 'text/plain' } });

const records = await creatorRecords(env(Astro.locals).DB, name);
const creator = { slug, name, ...records };
const total = creator.themes.length + creator.plugins.length + creator.posts.length;
cacheHeaders(Astro.response.headers, [`creator:${slug}`]);

---

<Base
  path={`/creators/${creator.slug}/`}
  title={creator.name}
  description={`${creator.name} in the Omarchy archive — ${total} named record${total === 1 ? '' : 's'}.`}
>
  <p class="pagehead__meta" data-pagefind-ignore="all">
    <a href="/creators/">Creators</a> / {creator.name}
  </p>

  <div class="pagehead">
    <h1>{creator.name}</h1>
    <p class="pagehead__lede">
      Records that name {creator.name} as author. Nothing here is inferred from a screenshot.
    </p>
  </div>

  {
    creator.themes.length > 0 && (
      <section class="section">
        <div class="section__head">
          <h2>
            Themes <span class="section__count">{creator.themes.length}</span>
          </h2>
        </div>
        <div class="grid">
          {creator.themes.map((theme) => (
            <Card type="theme" item={theme} />
          ))}
        </div>
      </section>
    )
  }

  {
    creator.plugins.length > 0 && (
      <section class="section">
        <div class="section__head">
          <h2>
            Plugins <span class="section__count">{creator.plugins.length}</span>
          </h2>
        </div>
        <div class="grid">
          {creator.plugins.map((plugin) => (
            <Card type="plugin" item={plugin} />
          ))}
        </div>
      </section>
    )
  }

  {
    creator.posts.length > 0 && (
      <section class="section">
        <div class="section__head">
          <h2>
            Posts <span class="section__count">{creator.posts.length}</span>
          </h2>
        </div>
        <div class="grid">
          {creator.posts.map((post) => (
            <Card type="post" item={post} />
          ))}
        </div>
      </section>
    )
  }
</Base>
