---
import Card from '../../components/Card.astro';
import Gallery from '../../components/Gallery.astro';
import Base from '../../layouts/Base.astro';
import { browsablePlugins, counts, tagFacets, valueFacets } from '../../lib/content';

const items = browsablePlugins;

const groups = [
  {
    id: 'ownership',
    label: 'Origin',
    options: valueFacets(items, (plugin) => (plugin.first_party ? 'first-party' : 'third-party')),
  },
  {
    id: 'kind',
    label: 'Kind',
    options: valueFacets(items, (plugin) => plugin.kinds[0]),
  },
  {
    id: 'tag',
    label: 'Tags',
    options: tagFacets(items, 2),
  },
];
---

<Base
  path="/plugins/"
  title="Plugins"
  description={`The ${counts.plugins} plugins in the Omarchy marketplace, with the install command from the official catalog. Browse the most-starred, or open the complete index.`}
  indexable={false}
>
  <div class="pagehead">
    <h1>Plugins</h1>
    <p class="pagehead__lede">
      Every installable plugin in the marketplace is in this archive —
      <strong>{counts.plugins}</strong> of them, each with its own page and the
      install command copied straight from the official
      <a href="https://plugins.omarchy.org/" rel="noopener">catalog</a>. This page
      shows the {items.length} worth browsing: everything Omarchy ships, then the
      community by stars.
    </p>
    <p class="actions">
      <a class="btn btn--primary" href="/plugins/all/">
        Complete index · {counts.plugins} plugins
      </a>
    </p>
    <p class="notice">
      Plugins run as unsandboxed code. This site does not verify security. Read the repo before
      you enable anything.
    </p>
  </div>

  <Gallery
    groups={groups}
    total={items.length}
    defaultSort="newest"
    sorts={[
      { value: 'newest', label: 'newest' },
      { value: 'name', label: 'a→z' },
    ]}
  >
    {items.map((plugin, index) => <Card type="plugin" item={plugin} eager={index < 4} />)}
  </Gallery>
</Base>
