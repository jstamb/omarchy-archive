---
import CommandBox from '../components/CommandBox.astro';
import Base from '../layouts/Base.astro';
import { apps, meta, omarchyOfficial } from '../lib/content';

/**
 * Every command Omarchy actually ships, read out of `bin/` in the omarchy repo.
 * `omarchy <group> <name>` dispatches to `omarchy-<group>-<name>`, which is why
 * the hyphenated form works too.
 */
const commands = [
  {
    thing: 'Bundled theme',
    command: 'omarchy theme set <name>',
    menu: 'Style → Theme',
    note: 'Name is lowercased and spaces become dashes, so the slug works.',
  },
  {
    thing: 'Extra theme',
    command: 'omarchy theme install https://github.com/org/omarchy-<name>-theme.git',
    menu: 'Install → Style → Theme',
    note: 'Clones into ~/.config/omarchy/themes. Keep the .git suffix.',
  },
  {
    thing: 'Third-party plugin',
    command: 'omarchy plugin add https://github.com/org/repo.git --enable',
    menu: 'Setup → Plugins → Add',
    note: 'Add --yes for non-interactive shells. Alias: omarchy plugin install.',
  },
  {
    thing: 'Bundled plugin / bar widget',
    command: 'omarchy plugin enable <id>',
    menu: 'Setup → Plugins',
    note: 'Takes an optional placement: --section left|center|right, --before/--after <id>.',
  },
  {
    thing: 'Whole bar',
    command: 'omarchy bar use <id>',
    menu: 'Setup → Bar',
    note: 'A bar replaces the bar in use rather than taking a place on one.',
  },
  {
    thing: 'Web app',
    command: '—',
    menu: 'Install → Web App',
    note: 'No one-line command — the menu asks for a name and URL, and grabs the icon from the favicon.',
  },
  {
    thing: 'Package',
    command: 'omarchy pkg add <name>…',
    menu: 'Install → Package',
    note: 'omarchy pkg install (no args) opens the fuzzy picker instead.',
  },
];
---

<Base
  path="/install/"
  title="Install"
  description={`Pin ${meta.site_name} in your launcher as a web app, and the exact install commands for every kind of Omarchy record.`}
  searchType="page"
>
  <div class="pagehead">
    <h1>Install</h1>
    <p class="pagehead__lede">
      Two things live here: how to use this archive as an app, and the command table every
      record copies from. Omarchy itself is installed from
      <a href={omarchyOfficial.install} rel="noopener">omarchy.org</a> — this page does not
      ship the ISO.
    </p>
  </div>

  <div class="prose">
    <section class="section">
      <div class="section__head">
        <h2>Start with Omarchy</h2>
      </div>
      <p>
        Get the ISO from the
        <a href={omarchyOfficial.install} rel="noopener">homepage install section</a>. Direct
        file:
        <a href={omarchyOfficial.iso} rel="noopener">Omarchy {omarchyOfficial.isoVersion} ISO</a>
        (<a href={omarchyOfficial.isoSha256} rel="noopener">SHA-256</a>,
        <a href={omarchyOfficial.isoSig} rel="noopener">signature</a>). The manual stays
        canonical:
        <a href={omarchyOfficial.manual} rel="noopener">omarchy.org/manual</a>,
        <a href={omarchyOfficial.gettingStarted} rel="noopener">getting started</a>.
      </p>
    </section>

    <section class="section">
      <div class="section__head">
        <h2>Use this archive as an app</h2>
      </div>
      <p>
        Omarchy turns any URL into a launcher entry with its own icon and window. Add it from
        the menu — it asks for a name and URL, and fetches the icon from the site's favicon:
      </p>
      <pre class="command"><code>Super + Space → Install → Web App
  Name: Archive
  URL:  {meta.site_url}</code></pre>
      <p>
        Name it <strong>Archive</strong>: short, quick to type, and it sorts to the top of the
        launcher. It then shows up like any other app, and you remove it from
        <code>Super + Space → Remove → Web App</code>.
      </p>
    </section>

    <section class="section">
      <div class="section__head">
        <h2>The command table</h2>
        <span class="section__count">read from omarchy/bin</span>
      </div>
      <p>
        These are the only install commands this site will ever print. When a record has no
        known command, the page says so and links the listing instead of guessing.
      </p>
      <table>
        <thead>
          <tr>
            <th>Thing</th>
            <th>Command</th>
            <th>Menu</th>
          </tr>
        </thead>
        <tbody>
          {
            commands.map((row) => (
              <tr>
                <td>{row.thing}</td>
                <td>
                  <code>{row.command}</code>
                  <br />
                  <small>{row.note}</small>
                </td>
                <td><small>{row.menu}</small></td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <p>
        Menu paths all start at <kbd>Super</kbd> + <kbd>Space</kbd>.
      </p>
    </section>

    {
      apps.length > 0 && (
        <section class="section">
          <div class="section__head">
            <h2>Apps &amp; packages</h2>
            <span class="section__count">{apps.length}</span>
          </div>
          <div class="grid">
            {apps.map((app) => (
              <div class="panel">
                <span class="panel__title">
                  {app.name} · {app.channel}
                </span>
                <CommandBox
                  install={app.install}
                  menuPath={app.menu_path ?? null}
                  fallbackLabel="Open the listing"
                />
              </div>
            ))}
          </div>
        </section>
      )
    }
  </div>
</Base>
