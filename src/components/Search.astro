---
interface Props {
  placeholder?: string;
  /** Rendered under the field until the first query. */
  note?: string;
  /** Unique per instance — the page can carry more than one search box. */
  id?: string;
  /** Compact variant for the sidebar. */
  compact?: boolean;
}

const {
  placeholder = 'Search setups, themes, plugins…',
  note = 'Full-text search across every record.',
  id = 'site-search',
  compact = false,
} = Astro.props;
---

<div class:list={['search', compact && 'search--compact']} data-search data-pagefind-ignore="all">
  {/* A real GET form so Enter (and no-JS) reaches the full results page. */}
  <form class="search__form" data-search-form action="/search/" method="get" role="search">
    <label class="search__label" for={id} hidden>Search the archive</label>
    <input
      class="search__input"
      id={id}
      name="q"
      type="search"
      autocomplete="off"
      placeholder={placeholder}
      data-search-input
    />
  </form>
  <p class="search__note" data-search-note role="status" aria-live="polite">{note}</p>
  <ol class="search__results" data-search-results></ol>
  <a class="search__all" data-search-all href="/search/" hidden>View all results</a>
</div>

<script>
  /*
   * A live preview: the top 8 hits appear as you type, and "View all" plus the
   * form's Enter both hand off to /search/ for the paged, filterable results.
   * Every box on the page shares one lazily-initialised engine (see
   * scripts/search.ts) so the index is fetched and parsed once.
   */
  import { cleanQuery, track } from '../scripts/analytics';
  import { MIN_QUERY_LENGTH, buildSearchHref, loadEngine } from '../scripts/search';
  import type { PagefindEngine, PagefindHitData, PagefindSearchResult } from '../scripts/search';

  function wire(root: HTMLElement) {
    const form = root.querySelector<HTMLFormElement>('[data-search-form]');
    const input = root.querySelector<HTMLInputElement>('[data-search-input]');
    const results = root.querySelector<HTMLOListElement>('[data-search-results]');
    const note = root.querySelector<HTMLElement>('[data-search-note]');
    const all = root.querySelector<HTMLAnchorElement>('[data-search-all]');
    if (!form || !input || !results || !note || !all) return;

    const idleNote = note.textContent ?? '';
    let engine: PagefindEngine | null = null;
    let token = 0;

    const run = async (query: string) => {
      const current = ++token;
      if (query.trim().length < MIN_QUERY_LENGTH) {
        results.replaceChildren();
        note.textContent = idleNote;
        all.hidden = true;
        return;
      }

      if (!engine) {
        note.textContent = 'Loading index…';
        try {
          engine = await loadEngine();
        } catch {
          note.textContent = import.meta.env.DEV
            ? 'Search index is built by `npm run build` — not available in dev.'
            : 'Search is unavailable right now. Check your connection and try again.';
          all.hidden = true;
          return;
        }
        if (current !== token) return;
      }

      let found: PagefindSearchResult;
      try {
        found = await engine.search(query);
      } catch {
        if (current !== token) return;
        note.textContent = 'Search failed.';
        all.hidden = true;
        return;
      }
      if (current !== token) return;

      // Only the eight visible fragments are fetched, never the whole result set.
      let top: PagefindHitData[];
      try {
        top = await Promise.all(found.results.slice(0, 8).map((hit) => hit.data()));
      } catch {
        if (current !== token) return;
        note.textContent = 'Search failed.';
        all.hidden = true;
        return;
      }
      if (current !== token) return;

      results.replaceChildren(
        ...top.map((hit) => {
          const li = document.createElement('li');
          const link = document.createElement('a');
          link.href = hit.url;
          link.textContent = hit.meta?.title || hit.url;
          const excerpt = document.createElement('p');
          excerpt.innerHTML = hit.excerpt;
          li.append(link, excerpt);
          return li;
        }),
      );

      const total = found.results.length;
      note.textContent = total ? `${total} match${total === 1 ? '' : 'es'}` : 'No matches.';
      if (total) {
        all.hidden = false;
        all.href = buildSearchHref({ q: input.value, type: '', page: 1 });
        all.textContent = `View all ${total} result${total === 1 ? '' : 's'}`;
      } else {
        all.hidden = true;
      }
    };

    /*
     * Query tracking is deliberately not wired to `run`. This is a live search
     * — `run` fires on a 150ms debounce while you type, so "thinkpad" would
     * report eight searches for t, th, thi, … and the useful row would be
     * buried under its own prefixes.
     *
     * Two signals count as a search, both unambiguous intent:
     *   enter        - submitting the form (which also navigates to /search/).
     *   result_click - clicking a preview hit. Results appear as you type, so
     *                  most people never submit; they read the list and click.
     * A query counts once either way — `tracked` dedupes.
     */
    let tracked = '';
    const submitted = (via: string) => {
      const query = cleanQuery(input.value);
      if (!query || query === tracked) return;
      tracked = query;
      track('search', {
        query,
        results: results.children.length,
        // Which box: the sidebar one is on every page, the hero one is not.
        box: root.classList.contains('search--compact') ? 'sidebar' : 'page',
        via,
      });
    };

    let timer = 0;
    input.addEventListener('input', () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => void run(input.value), 150);
    });
    input.addEventListener('focus', () => void loadEngine().catch(() => {}));

    // Enter submits the form: report the search, then let it navigate to /search/.
    form.addEventListener('submit', () => submitted('enter'));

    results.addEventListener('click', (event) => {
      const link = (event.target as HTMLElement | null)?.closest('a');
      if (!link) return;
      const items = [...results.querySelectorAll('li')];
      submitted('result_click');
      track('search_result_click', {
        query: cleanQuery(input.value),
        position: items.findIndex((li) => li.contains(link)) + 1,
        to: new URL(link.href).pathname,
      });
    });
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-search]')) wire(root);
</script>

<style>
  .search__form {
    margin: 0;
  }
  .search__all {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: 0.85rem;
    font-weight: 700;
  }
  .search__all[hidden] {
    display: none;
  }
  .search--compact .search__all {
    font-size: 0.78rem;
  }
</style>
