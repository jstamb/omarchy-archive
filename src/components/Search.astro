---
interface Props {
  placeholder?: string;
  /** Rendered under the field until the first query. */
  note?: string;
  /** Unique per instance — the page can carry more than one search box. */
  id?: string;
  /** Compact variant for the sidebar. */
  compact?: boolean;
}

const {
  placeholder = 'Search setups, themes, plugins…',
  note = 'Full-text search across every record.',
  id = 'site-search',
  compact = false,
} = Astro.props;
---

<div class:list={['search', compact && 'search--compact']} data-search data-pagefind-ignore="all">
  <label class="search__label" for={id} hidden>Search the archive</label>
  <input
    class="search__input"
    id={id}
    type="search"
    autocomplete="off"
    placeholder={placeholder}
    data-search-input
  />
  <p class="search__note" data-search-note>{note}</p>
  <ol class="search__results" data-search-results></ol>
</div>

<script>
  /*
   * Pagefind's index only exists after `pagefind --site dist`, so the bundle is
   * loaded on first use and a missing index degrades to a note, not an error.
   *
   * There can be more than one box on a page — the sidebar carries one on every
   * page, and the homepage has its own in the hero. They share a single engine
   * promise, so the index is fetched and initialised once no matter how many
   * boxes are wired up.
   */
  import { cleanQuery, track } from '../scripts/analytics';

  let loading: Promise<any> | null = null;

  const loadEngine = () => {
    if (loading) return loading;
    loading = (async () => {
      const path = '/pagefind/pagefind.js';
      const module = await import(/* @vite-ignore */ path);
      // noWorker is required, not an optimisation: pagefind 1.5.2's shared
      // web worker answers `init` and then never answers `search`, so the
      // query hangs forever. On the main thread the whole search is <100ms
      // for an index this size.
      await module.options({ noWorker: true });
      await module.init();
      return module;
    })();
    return loading;
  };

  function wire(root: HTMLElement) {
    const input = root.querySelector<HTMLInputElement>('[data-search-input]');
    const results = root.querySelector<HTMLOListElement>('[data-search-results]');
    const note = root.querySelector<HTMLElement>('[data-search-note]');
    if (!input || !results || !note) return;

    const idleNote = note.textContent ?? '';
    let engine: any = null;
    let token = 0;

    const run = async (query: string) => {
      const current = ++token;
      if (query.trim().length < 2) {
        results.replaceChildren();
        note.textContent = idleNote;
        return;
      }

      if (!engine) {
        note.textContent = 'Loading index…';
        try {
          engine = await loadEngine();
        } catch {
          note.textContent = 'Search index is built by `npm run build` — not available in dev.';
          return;
        }
        if (current !== token) return;
      }

      const search = await engine.search(query);
      if (current !== token) return;

      const top = await Promise.all(search.results.slice(0, 8).map((hit: any) => hit.data()));
      if (current !== token) return;

      results.replaceChildren(
        ...top.map((hit: any) => {
          const li = document.createElement('li');
          const link = document.createElement('a');
          link.href = hit.url;
          link.textContent = hit.meta?.title || hit.url;
          const excerpt = document.createElement('p');
          excerpt.innerHTML = hit.excerpt;
          li.append(link, excerpt);
          return li;
        }),
      );
      note.textContent = search.results.length
        ? `${search.results.length} match${search.results.length === 1 ? '' : 'es'}`
        : 'No matches.';
    };

    /*
     * Query tracking is deliberately not wired to `run`. This is a live search
     * — `run` fires on a 150ms debounce while you type, so "thinkpad" would
     * report eight searches for t, th, thi, … and the useful row would be
     * buried under its own prefixes.
     *
     * There is no form and no submit button here, so a submit has to be
     * defined. Two signals count, both unambiguous intent:
     *
     *   enter         - the explicit one.
     *   result_click  - the one that actually happens. Results appear as you
     *                   type, so most people never press Enter; they read the
     *                   list and click. Tracking Enter alone would have missed
     *                   most real searches and made the data look like nobody
     *                   searches.
     *
     * A query counts once either way: pressing Enter and then clicking a
     * result is one search, not two, which is what `tracked` is for.
     */
    let tracked = '';
    const submitted = (via: string) => {
      const query = cleanQuery(input.value);
      if (!query || query === tracked) return;
      tracked = query;
      track('search', {
        query,
        results: results.children.length,
        // Which box: the sidebar one is on every page, the hero one is not.
        box: root.classList.contains('search--compact') ? 'sidebar' : 'page',
        via,
      });
    };

    let timer = 0;
    input.addEventListener('input', () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => void run(input.value), 150);
    });
    input.addEventListener('focus', () => void loadEngine().catch(() => {}));

    input.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter') return;
      // Enter can land before the debounce has run; search now, then report.
      window.clearTimeout(timer);
      void run(input.value).then(() => submitted('enter'));
    });

    results.addEventListener('click', (event) => {
      const link = (event.target as HTMLElement | null)?.closest('a');
      if (!link) return;
      const items = [...results.querySelectorAll('li')];
      submitted('result_click');
      track('search_result_click', {
        query: cleanQuery(input.value),
        position: items.findIndex((li) => li.contains(link)) + 1,
        to: new URL(link.href).pathname,
      });
    });
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-search]')) wire(root);
</script>
