{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omarchyarchive.com/bot/schema.json",
  "title": "Omarchy Archive record schemas",
  "description": "One definition per data/*.json file. bot/validate.mjs enforces these plus the cross-file rules it documents.",

  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "description": "Stable, unique within its file, kebab-case (plugins keep their reverse-DNS catalog id). Never rewritten once published."
    },
    "isoDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "nullableIsoDate": {
      "type": ["string", "null"],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "url": { "type": "string", "pattern": "^https://" },
    "nullableUrl": {
      "type": ["string", "null"],
      "pattern": "^https://"
    },
    "recordStatus": {
      "type": "string",
      "enum": ["active", "unavailable", "deprecated", "replaced"]
    },
    "nullableId": {
      "type": ["string", "null"],
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "nullableInt": { "type": ["integer", "null"] },
    "image": {
      "type": ["string", "null"],
      "description": "Site-absolute path to a committed WebP (/images/<kind>/<id>.webp) or an https URL when hotlinking a listing thumb.",
      "pattern": "^(/images/[a-z]+/[a-z0-9._-]+\\.webp|https://.+)$"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
    },
    "install": {
      "type": "object",
      "required": ["type", "command"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "theme-set",
            "theme-install",
            "plugin-add",
            "plugin-enable",
            "bar-use",
            "pkg",
            "menu",
            "webapp"
          ]
        },
        "command": {
          "type": ["string", "null"],
          "description": "Must start with `omarchy` or `omarchy-`, or be null when unknown. Never invented — copy it from the upstream catalog or the table in AGENTS.md.",
          "pattern": "^omarchy[- ]"
        },
        "hint": { "type": ["string", "null"] }
      }
    }
  },

  "meta": {
    "type": "object",
    "required": ["site_name", "site_url", "tagline", "disclaimer", "updated_at"],
    "properties": {
      "site_name": { "type": "string" },
      "site_url": { "$ref": "#/$defs/url" },
      "tagline": { "type": "string" },
      "positioning": { "type": "string" },
      "disclaimer": { "type": "string" },
      "repo_url": { "$ref": "#/$defs/url" },
      "updated_at": { "type": "string" }
    }
  },

  "sources": {
    "type": "array",
    "items": {
      "type": "object",
      "required": ["id", "name", "url", "kinds", "ingest"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "url": { "$ref": "#/$defs/url" },
        "kinds": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "blurb": { "type": ["string", "null"] },
        "official": { "type": "boolean" },
        "ingest": { "enum": ["manual", "catalog", "scrape"] },
        "catalog_url": { "$ref": "#/$defs/url" }
      }
    }
  },

  "posts": {
    "type": "array",
    "items": {
      "type": "object",
      "required": ["id", "kind", "title", "source_url", "source_platform", "tags", "added_at"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["setup", "theme", "plugin", "idea", "hardware", "other"] },
        "title": { "type": "string", "minLength": 3 },
        "summary": { "type": ["string", "null"] },
        "author": { "type": ["string", "null"] },
        "author_url": { "type": ["string", "null"] },
        "source_platform": {
          "enum": ["x", "reddit", "github", "youtube", "mastodon", "web"]
        },
        "source_url": { "$ref": "#/$defs/url" },
        "image": { "$ref": "#/$defs/image" },
        "image_hosted": { "type": "boolean" },
        "device": { "type": ["string", "null"] },
        "form_factor": {
          "type": ["string", "null"],
          "enum": ["desktop", "laptop", "tablet", "handheld", "server", null]
        },
        "tags": { "$ref": "#/$defs/tags" },
        "related_theme_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "related_plugin_ids": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "created_at": { "type": ["string", "null"] },
        "added_at": { "$ref": "#/$defs/isoDate" },
        "featured": { "type": "boolean" },
        "seen_on": { "type": ["string", "null"] },
        "first_seen_at": { "$ref": "#/$defs/nullableIsoDate" },
        "last_seen_at": { "$ref": "#/$defs/nullableIsoDate" },
        "last_changed_at": { "$ref": "#/$defs/nullableIsoDate" },
        "status": { "$ref": "#/$defs/recordStatus" },
        "replaced_by": { "$ref": "#/$defs/nullableId" },
        "original_asset_url": { "$ref": "#/$defs/nullableUrl" },
        "upstream_rev": { "type": ["string", "null"] },
        "rights_note": { "type": ["string", "null"] },
        "config_url": { "$ref": "#/$defs/nullableUrl" }
      }
    }
  },

  "themes": {
    "type": "array",
    "items": {
      "type": "object",
      "required": ["id", "name", "official", "bundled", "install", "tags", "added_at"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "author": { "type": ["string", "null"] },
        "official": { "type": "boolean" },
        "bundled": {
          "type": "boolean",
          "description": "True only for themes in the omarchy repo's themes/ directory."
        },
        "repo_url": { "type": ["string", "null"] },
        "listing_url": { "type": ["string", "null"] },
        "image": { "$ref": "#/$defs/image" },
        "image_hosted": { "type": "boolean" },
        "tone": { "type": ["string", "null"], "enum": ["dark", "light", null] },
        "palette": {
          "type": "array",
          "items": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
        },
        "tags": { "$ref": "#/$defs/tags" },
        "install": { "$ref": "#/$defs/install" },
        "seen_on": { "type": ["string", "null"] },
        "added_at": { "$ref": "#/$defs/isoDate" },
        "first_seen_at": { "$ref": "#/$defs/nullableIsoDate" },
        "last_seen_at": { "$ref": "#/$defs/nullableIsoDate" },
        "last_changed_at": { "$ref": "#/$defs/nullableIsoDate" },
        "status": { "$ref": "#/$defs/recordStatus" },
        "replaced_by": { "$ref": "#/$defs/nullableId" },
        "original_asset_url": { "$ref": "#/$defs/nullableUrl" },
        "upstream_rev": { "type": ["string", "null"] },
        "rights_note": { "type": ["string", "null"] },
        "supported_releases": { "type": "array", "items": { "type": "string" } }
      }
    }
  },

  "plugins": {
    "type": "array",
    "items": {
      "type": "object",
      "required": ["id", "name", "first_party", "install", "tags", "added_at"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "author": { "type": ["string", "null"] },
        "summary": { "type": ["string", "null"] },
        "repo_url": { "type": ["string", "null"] },
        "listing_url": { "type": ["string", "null"] },
        "image": { "$ref": "#/$defs/image" },
        "image_hosted": { "type": "boolean" },
        "tags": { "$ref": "#/$defs/tags" },
        "kinds": { "type": "array", "items": { "type": "string" } },
        "category": { "type": ["string", "null"] },
        "first_party": {
          "type": "boolean",
          "description": "True only when the marketplace catalog says sourceType: builtin."
        },
        "stars": { "type": ["integer", "null"] },
        "install": { "$ref": "#/$defs/install" },
        "warning": { "type": ["string", "null"] },
        "seen_on": { "type": ["string", "null"] },
        "added_at": { "$ref": "#/$defs/isoDate" },
        "first_seen_at": { "$ref": "#/$defs/nullableIsoDate" },
        "last_seen_at": { "$ref": "#/$defs/nullableIsoDate" },
        "last_changed_at": { "$ref": "#/$defs/nullableIsoDate" },
        "status": { "$ref": "#/$defs/recordStatus" },
        "replaced_by": { "$ref": "#/$defs/nullableId" },
        "original_asset_url": { "$ref": "#/$defs/nullableUrl" },
        "upstream_rev": { "type": ["string", "null"] },
        "rights_note": { "type": ["string", "null"] },
        "supported_releases": { "type": "array", "items": { "type": "string" } }
      }
    }
  },

  "apps": {
    "type": "array",
    "items": {
      "type": "object",
      "required": ["id", "name", "channel", "install"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "channel": { "enum": ["omarchy-menu", "pkg", "webapp", "aur"] },
        "menu_path": { "type": ["string", "null"] },
        "install": { "$ref": "#/$defs/install" },
        "added_at": { "$ref": "#/$defs/isoDate" }
      }
    }
  },

  "timeline": {
    "type": "array",
    "description": "Omarchy's release history, written by bot/ingest-timeline.mjs from the repo's own releases. Newest first. Never hand-edited — the scheduled Action overwrites it.",
    "items": {
      "type": "object",
      "required": ["id", "version", "date", "tier", "release_url"],
      "properties": {
        "id": { "type": "string", "pattern": "^v\\d+\\.\\d+\\.\\d+" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+" },
        "major": { "type": "integer" },
        "date": { "$ref": "#/$defs/isoDate" },
        "published_at": { "type": "string" },
        "tier": {
          "enum": ["node", "tick"],
          "description": "node = a release worth stopping at, rendered in full. tick = a mark on the line between nodes."
        },
        "score": { "type": "integer" },
        "headline": {
          "type": ["string", "null"],
          "description": "The release's own editorial name — \"The Quattro Release\". Null when the notes only carry a version number."
        },
        "summary": { "type": ["string", "null"] },
        "highlights": { "type": "array", "items": { "type": "string" } },
        "contributors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["handle"],
            "additionalProperties": false,
            "properties": {
              "handle": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$" },
              "first_time": {
                "type": "boolean",
                "description": "GitHub's own \"made their first contribution\" line — the release someone joined."
              },
              "pull_request": { "type": ["string", "null"] }
            }
          }
        },
        "release_url": { "$ref": "#/$defs/url" },
        "notes_chars": { "type": "integer" },
        "upstream_id": { "type": ["string", "null"] },
        "payload_hash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "parser_version": { "type": ["integer", "null"] }
      }
    }
  },

  "source_status": {
    "type": "object",
    "additionalProperties": {
      "type": "object",
      "properties": {
        "last_attempt_at": { "$ref": "#/$defs/nullableIsoDate" },
        "last_success_at": { "$ref": "#/$defs/nullableIsoDate" },
        "upstream_count": { "$ref": "#/$defs/nullableInt" },
        "indexed_count": { "$ref": "#/$defs/nullableInt" },
        "excluded_count": { "$ref": "#/$defs/nullableInt" },
        "note": { "type": ["string", "null"] }
      }
    }
  }
}
